# ─────────────────────────────────────────────────────────────
# discord-desk configuration. Copy to .env and fill in.
# NEVER commit .env. Every value below is optional except where marked.
# ─────────────────────────────────────────────────────────────

# ── AI model (xAI / Grok) ────────────────────────────────────
# REQUIRED for real analysis. Get one at https://console.x.ai
XAI_API_KEY=
# Set to 1 to run fully offline with a mock model (no key needed; output is placeholder text).
XAI_MOCK=0
# Primary and fallback models (fallback is used if the primary call errors).
XAI_PRIMARY_MODEL=grok-4.6
XAI_FALLBACK_MODEL=grok-4-1-fast-reasoning
# Reasoning token budget for the primary model on the deep-dive call.
XAI_THINKING_BUDGET=5000
# Override the API base URL (default https://api.x.ai/v1).
XAI_BASE_URL=

# ── Discord ──────────────────────────────────────────────────
# One webhook per channel (Server Settings → Integrations → Webhooks).
# REQUIRED unless you only ever use --dry-run.
DISCORD_WEBHOOK_URL_BTC=
DISCORD_WEBHOOK_URL_XRP=
# Optional shared fallback used for any symbol without its own webhook.
# (Per-symbol form also works: DISCORD_WEBHOOK_URL_<BASE> e.g. DISCORD_WEBHOOK_URL_ETH)
DISCORD_WEBHOOK_URL=

# ── Analysis settings ───────────────────────────────────────
# Higher (bias) and lower (entry) timeframes — Binance intervals.
DISCORD_AI_HIGHER_TF=1d
DISCORD_AI_LOWER_TF=15m
# Trader mode: indicator | smc | scalping | divergence | volume-profile
DISCORD_AI_MODE=smc
# Trade horizon: scalp | intraday | swing | position (see src/lib/cryptoAiConfig.ts)
DISCORD_AI_HORIZON=swing
# Minimum reward:risk to TP1, and minimum number of confluence signals.
DISCORD_MIN_RR=1.5
DISCORD_MIN_CONFLUENCE=3
# Default symbols for CLI runs without --symbol (comma separated).
DISCORD_DESK_SYMBOLS=
# Legacy single-symbol default (used only if DISCORD_DESK_SYMBOLS is empty).
DISCORD_BTC_SYMBOL=BTCUSDT

# ── Scheduler (cron syntax, evaluated in DESK_SCHEDULE_TZ) ──
# Defaults match the original cron: BTC 05:45 UTC, XRP 05:50 UTC. Use "off" to disable.
DESK_SCHEDULE_BTC=45 5 * * *
DESK_SCHEDULE_XRP=50 5 * * *
DESK_SCHEDULE_TZ=UTC
# Extra symbols: "SYMBOL=cron;SYMBOL=cron"  e.g. ETHUSDT=55 5 * * *
DESK_EXTRA_SCHEDULES=
# Set to 1 to make scheduled runs dry runs (build payload, don't post). Handy for testing.
DESK_DRY_RUN=0

# ── Cache / history ─────────────────────────────────────────
# Default: JSON file in DATA_DIR. Set DATABASE_URL to use Postgres instead (tables auto-created).
# DATABASE_URL is shared by the desk cache and the tracker (tracker uses src/tracker/schema.sql).
DATA_DIR=./data
DATABASE_URL=
# Force the JSON cache even if DATABASE_URL is set: json | auto
DESK_CACHE=auto
# Set to 1 to force SSL (no cert verification) on Postgres; "sslmode=require" in the URL also enables it.
DB_SSL=0
# How many past runs to keep in the JSON history.
DESK_MAX_RUNS=50

# ── Dashboard ───────────────────────────────────────────────
# Set to off to disable the web dashboard.
DASHBOARD=on
PORT=3000
# 127.0.0.1 = local only. Use 0.0.0.0 in Docker / to expose (then set DASHBOARD_TOKEN!).
HOST=127.0.0.1
# If set, dashboard/API require ?token=... or header x-dashboard-token.
DASHBOARD_TOKEN=

# ── Trade tracker ───────────────────────────────────────────
# bundled (default): the tracker runs inside this service, stores trades in an embedded
#   Postgres (PGlite) under DATA_DIR/tracker-db, or in DATABASE_URL Postgres if set.
# external: set TRACKER_URL to a separately running tracker (e.g. `npm run tracker`).
# off: no tracker at all.
TRACKER_MODE=bundled
# Leave blank for bundled. Set to use an external tracker, e.g. http://tracker:3101
TRACKER_URL=
# Shared secret. If set, the tracker requires it on POST routes (header X-Tracker-Key or Bearer)
# and the desk sends it. Blank = open (fine on localhost; set it if the port is reachable).
TRACKER_API_KEY=
TRACKER_DESK_USER_ID=discord-desk
# Port when running the tracker on its own (npm run tracker / docker compose --profile split).
TRACKER_PORT=3101
# Tracker DB: auto (DATABASE_URL if set, else local file) | local (force local file) | memory (tests)
TRACKER_DB=auto
# How often the tracker checks Binance prices against open setups.
TRACKER_POLL_INTERVAL_MS=15000
# Set 0 to stop the tracker posting entry/TP/stop/cancel/weekly messages to Discord.
# (Tracker posts go to the same per-symbol webhooks as the desk.)
TRACKER_NOTIFY=1
# Which trade sources get Discord pings / appear in the weekly recap.
DISCORD_NOTIFY_SOURCES=
DISCORD_SILENT_SOURCES=
DISCORD_WEEKLY_SOURCES=discord_desk
# Weekly recap: day of week (0=Sunday) and hour (UTC).
WEEKLY_DOW=0
WEEKLY_HOUR_UTC=18

# ── Paper account (simulated P&L on tracked desk trades) ────
PAPER_SOURCES=discord_desk
PAPER_STARTING_EQUITY=1000
PAPER_RISK_PCT=0.0075
PAPER_MAX_LEVERAGE=2
PAPER_MAX_MARGIN_FRAC=0.20
PAPER_MAX_OPEN_RISK_PCT=0.02
PAPER_HALT_DD_PCT=0.25
